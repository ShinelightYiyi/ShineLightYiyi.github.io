---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
---

<BaseLayout title="404 · 页面未找到">
  <div class="min-h-[60vh] flex items-center justify-center">
    <div class="text-center max-w-md">
      <div class="font-display font-bold tracking-tightest text-cobalt-600 leading-none"
           style="font-size: clamp(6rem, 14vw, 10rem);">
        404
      </div>
      <div class="eyebrow justify-center mb-3">Page not found</div>
      <p class="text-ink-600 leading-relaxed mb-8">
        你访问的路径不存在，可能已被移动或删除。
      </p>
      <div class="flex justify-center gap-3">
        <a href="/" class="btn-primary">
          <Icon name="home" class="w-4 h-4" />
          回到主页
        </a>
        <a href="/posts" class="btn-ghost">
          浏览文章
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
