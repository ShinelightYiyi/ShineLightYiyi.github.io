---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '~/config';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import PostCard from '@components/PostCard.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Group by year
type Group = { year: number; posts: typeof posts };
const groups: Group[] = [];
for (const p of posts) {
  const y = p.data.date.getFullYear();
  let g = groups.find((x) => x.year === y);
  if (!g) {
    g = { year: y, posts: [] };
    groups.push(g);
  }
  g.posts.push(p);
}
---

<BaseLayout title="所有文章" description="所有发表的文章列表，按时间倒序展示。">
  <PageHeader
    eyebrow="Archive"
    title="所有文章"
    subtitle="按时间倒序排列。可在侧边栏按分类浏览，或使用搜索快速筛选。"
    meta={[
      `${posts.length} articles`,
      `${CATEGORIES.length} categories`,
    ]}
  />

  {posts.length === 0 ? (
    <div class="mt-10 card-industrial p-16 text-center text-ink-500">
      暂无文章 — 请在
      <a href="/editor" class="text-cobalt-600 hover:underline mx-1">编辑模式</a>
      中创建。
    </div>
  ) : (
    <div class="mt-10 space-y-12">
      {groups.map((g) => (
        <section>
          <div class="sticky top-0 lg:top-2 z-10 -mx-2 px-2 py-2 mb-5 backdrop-blur bg-ink-50/70">
            <div class="flex items-baseline gap-3">
              <span class="font-display font-bold text-3xl tracking-tightest text-ink-900 tabular-nums">
                {g.year}
              </span>
              <span class="text-xs font-mono uppercase tracking-widest text-ink-500">
                {g.posts.length} articles
              </span>
              <span class="flex-1 h-px bg-line ml-2"></span>
            </div>
          </div>
          <div class="grid md:grid-cols-2 gap-5">
            {g.posts.map((p, i) => (
              <PostCard post={p} index={i} />
            ))}
          </div>
        </section>
      ))}
    </div>
  )}
</BaseLayout>
