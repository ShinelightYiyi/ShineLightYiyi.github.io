---
import { getCollection } from 'astro:content';
import { SITE, AUTHOR, CATEGORIES, SOCIAL } from '~/config';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import Icon from '@components/Icon.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = posts.filter((p) => p.data.featured).slice(0, 1)[0];
const recent = posts.filter((p) => p.slug !== featured?.slug).slice(0, 6);

const stats = {
  posts: posts.length,
  tags: new Set(posts.flatMap((p) => p.data.tags)).size,
  categories: new Set(posts.map((p) => p.data.category)).size,
};
---

<BaseLayout>
  <!-- HERO -->
  <section
    class="relative card-industrial overflow-hidden p-8 md:p-12 lg:p-16
           shadow-crisp animate-fade-up"
  >
    <!-- Decorative accent line -->
    <div
      class="absolute inset-x-0 top-0 h-px"
      style="background: linear-gradient(90deg, transparent, #1E5EFF 50%, transparent);"
    >
    </div>
    <!-- Decorative grid -->
    <div
      class="absolute -right-16 -top-16 h-64 w-64 opacity-[0.05] pointer-events-none"
      style="background-image: linear-gradient(to right, #0A2540 1px, transparent 1px), linear-gradient(to bottom, #0A2540 1px, transparent 1px); background-size: 20px 20px;"
    >
    </div>

    <div class="grid lg:grid-cols-[1.4fr_1fr] gap-10 items-center relative">
      <div>
        <div class="eyebrow mb-5">Personal Journal · Est. {new Date().getFullYear()}</div>
        <h1
          class="font-display font-bold tracking-tightest leading-[0.95]
                 text-[clamp(2.5rem,6vw,5rem)] text-ink-950"
        >
          {AUTHOR.name}<span class="text-cobalt-600">.</span>
        </h1>
        <p class="mt-5 text-lg md:text-xl text-ink-600 leading-relaxed max-w-xl">
          {SITE.bio}
        </p>

        <!-- CTA row -->
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/posts" class="btn-primary">
            浏览文章
            <Icon name="arrow-right" class="w-4 h-4" />
          </a>
          <a href="/editor" class="btn-ghost">
            <Icon name="edit" class="w-4 h-4" />
            进入编辑模式
          </a>
        </div>

        <!-- Social row -->
        <div class="mt-10 flex items-center gap-5 text-ink-500">
          {SOCIAL.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.name}
              class="hover:text-cobalt-600 transition-colors flex items-center gap-1.5 text-sm"
            >
              <Icon name={s.icon} class="w-4 h-4" />
              <span class="hidden sm:inline">{s.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Stats panel -->
      <div class="grid grid-cols-3 gap-3">
        {[
          { label: 'Articles', value: stats.posts },
          { label: 'Tags', value: stats.tags },
          { label: 'Categories', value: stats.categories },
        ].map((s) => (
          <div class="border border-line rounded-md bg-ink-50/60 p-4 text-center">
            <div class="font-display tabular-nums text-3xl md:text-4xl font-bold text-ink-900">
              {String(s.value).padStart(2, '0')}
            </div>
            <div class="mt-1 text-[10px] font-mono uppercase tracking-widest text-ink-500">
              {s.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED -->
  {featured && (
    <section class="mt-12">
      <div class="flex items-baseline justify-between mb-5">
        <h2 class="font-display text-xl tracking-tight text-ink-900">
          <span class="eyebrow !text-cobalt-600 mr-2">★</span>
          Featured
        </h2>
      </div>
      <PostCard post={featured} />
    </section>
  )}

  <!-- RECENT -->
  <section class="mt-12">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="font-display text-xl tracking-tight text-ink-900">
        <span class="eyebrow mr-2">Recent</span>
        最近发表
      </h2>
      <a
        href="/posts"
        class="text-sm font-mono uppercase tracking-widest text-cobalt-600 hover:text-cobalt-700 flex items-center gap-1"
      >
        All Posts <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>

    {recent.length === 0 ? (
      <div class="card-industrial p-12 text-center">
        <div class="text-ink-400 mb-3">
          <Icon name="doc" class="w-12 h-12 mx-auto" strokeWidth={1.2} />
        </div>
        <p class="text-ink-600">还没有文章。</p>
        <p class="text-sm text-ink-500 mt-2">
          可在
          <a href="/editor" class="text-cobalt-600 hover:underline">编辑模式</a>
          中创建你的第一篇文章。
        </p>
      </div>
    ) : (
      <div class="grid md:grid-cols-2 gap-5">
        {recent.map((post, i) => (
          <PostCard post={post} index={i} />
        ))}
      </div>
    )}
  </section>

  <!-- CATEGORIES preview -->
  <section class="mt-16 mb-8">
    <h2 class="font-display text-xl tracking-tight text-ink-900 mb-5">
      <span class="eyebrow mr-2">Index</span>
      分类索引
    </h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {CATEGORIES.map((cat) => {
        const count = posts.filter((p) => p.data.category === cat.id).length;
        return (
          <a
            href={`/categories/${cat.id}`}
            class="group card-industrial p-5 flex items-center justify-between"
          >
            <div>
              <div class="font-display font-semibold text-ink-900 group-hover:text-cobalt-700 transition-colors">
                {cat.label}
              </div>
              <div class="mt-1 text-xs font-mono uppercase tracking-widest text-ink-500">
                {count} {count === 1 ? 'article' : 'articles'}
              </div>
            </div>
            <span class="text-cobalt-600 group-hover:translate-x-1 transition-transform">
              <Icon name="arrow-right" class="w-5 h-5" />
            </span>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
