---
import { getCollection } from 'astro:content';
import { CATEGORIES } from '~/config';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import PostCard from '@components/PostCard.astro';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({
    params: { id: c.id },
    props: { category: c },
  }));
}

const { category } = Astro.props as {
  category: (typeof CATEGORIES)[number];
};

const posts = (
  await getCollection(
    'posts',
    ({ data }) => !data.draft && data.category === category.id
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={category.label}
  description={`${category.label} 分类下的所有文章`}
>
  <PageHeader
    eyebrow="Category"
    title={category.label}
    subtitle={`此分类下共 ${posts.length} 篇文章`}
  />

  {posts.length === 0 ? (
    <div class="mt-10 card-industrial p-16 text-center text-ink-500">
      此分类下暂无文章
    </div>
  ) : (
    <div class="mt-10 grid md:grid-cols-2 gap-5">
      {posts.map((p, i) => <PostCard post={p} index={i} />)}
    </div>
  )}
</BaseLayout>
