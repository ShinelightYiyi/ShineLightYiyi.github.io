---
/**
 * PostCard — Industrial article preview card.
 * Used in post lists (home, /posts, tag pages).
 */
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '~/config';
import Icon from './Icon.astro';

export interface Props {
  post: CollectionEntry<'posts'>;
  index?: number;
  variant?: 'default' | 'compact';
}
const { post, index, variant = 'default' } = Astro.props;
const { title, subtitle, description, date, tags, category, cover, source } = post.data;
const cat = CATEGORIES.find((c) => c.id === category);

const dateStr = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});

const readTime = Math.max(
  2,
  Math.round((post.body?.length ?? 0) / 500)
);
---

<article
  class:list={[
    'group relative card-industrial overflow-hidden',
    variant === 'compact' ? 'p-5' : 'p-6 md:p-7',
  ]}
>
  <!-- Index number ribbon (top-right) -->
  {typeof index === 'number' && (
    <div
      class="absolute right-5 top-5 font-mono text-[10px] tracking-widest text-ink-400"
    >
      {String(index + 1).padStart(2, '0')}
    </div>
  )}

  <a href={`/posts/${post.slug}`} class="block">
    <!-- Meta row -->
    <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-widest text-ink-500 mb-3">
      {cat && (
        <span class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-cobalt-500"></span>
          {cat.label}
        </span>
      )}
      <span class="h-3 w-px bg-line"></span>
      <span class="flex items-center gap-1">
        <Icon name="calendar" class="w-3 h-3" />
        {dateStr}
      </span>
      <span class="h-3 w-px bg-line"></span>
      <span class="flex items-center gap-1">
        <Icon name="clock" class="w-3 h-3" />
        {readTime} min
      </span>
      {source === 'pdf' && (
        <>
          <span class="h-3 w-px bg-line"></span>
          <span
            class="inline-flex items-center gap-1 text-cobalt-600"
            title="Imported from PDF"
          >
            <Icon name="upload" class="w-3 h-3" /> PDF
          </span>
        </>
      )}
    </div>

    <!-- Title -->
    <h3
      class:list={[
        'font-display font-bold tracking-tight text-ink-900',
        'transition-colors group-hover:text-cobalt-700',
        variant === 'compact'
          ? 'text-lg leading-snug'
          : 'text-xl md:text-2xl leading-tight',
      ]}
    >
      {title}
    </h3>

    {subtitle && (
      <p class="mt-1 text-sm text-ink-500 italic">{subtitle}</p>
    )}

    <!-- Description -->
    {description && (
      <p class="mt-3 text-[15px] leading-relaxed text-ink-600 line-clamp-3">
        {description}
      </p>
    )}

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="mt-5 flex flex-wrap items-center gap-1.5">
        {tags.slice(0, 4).map((t) => (
          <span class="tag-chip">#{t}</span>
        ))}
      </div>
    )}

    <!-- Footer / Read CTA -->
    <div class="mt-5 flex items-center justify-between border-t border-dashed border-line pt-4">
      <span class="text-xs font-mono uppercase tracking-widest text-ink-400">
        Read article
      </span>
      <span
        class="flex items-center gap-1.5 text-cobalt-600 transition-transform
               group-hover:translate-x-1"
      >
        <Icon name="arrow-right" class="w-4 h-4" />
      </span>
    </div>
  </a>
</article>
