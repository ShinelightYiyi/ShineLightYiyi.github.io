---
/**
 * Icon — minimalist line-art icon system (Lucide-inspired).
 * Usage: <Icon name="home" class="w-5 h-5" />
 */
export interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
}
const { name, class: className = 'w-5 h-5', strokeWidth = 1.6 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {name === 'home' && (
    <>
      <path d="M3 11.5 12 4l9 7.5" />
      <path d="M5 10v10h14V10" />
    </>
  )}
  {name === 'doc' && (
    <>
      <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" />
      <path d="M14 3v6h6" />
      <path d="M8 13h8M8 17h6" />
    </>
  )}
  {name === 'tag' && (
    <>
      <path d="M20 12 12 20l-8-8V4h8z" />
      <circle cx="8" cy="8" r="1.5" />
    </>
  )}
  {name === 'user' && (
    <>
      <circle cx="12" cy="8" r="4" />
      <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" />
    </>
  )}
  {name === 'edit' && (
    <>
      <path d="M12 20h9" />
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z" />
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-3.5-3.5" />
    </>
  )}
  {name === 'arrow-right' && <path d="M5 12h14M13 5l7 7-7 7" />}
  {name === 'arrow-left' && <path d="M19 12H5M11 5l-7 7 7 7" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
  {name === 'chevron-right' && <path d="m9 6 6 6-6 6" />}
  {name === 'menu' && (
    <>
      <path d="M3 6h18M3 12h18M3 18h18" />
    </>
  )}
  {name === 'x' && <path d="M18 6 6 18M6 6l12 12" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'check' && <path d="m5 12 5 5L20 7" />}
  {name === 'upload' && (
    <>
      <path d="M12 16V4M6 10l6-6 6 6" />
      <path d="M4 20h16" />
    </>
  )}
  {name === 'download' && (
    <>
      <path d="M12 4v12M6 14l6 6 6-6" />
      <path d="M4 4h16" />
    </>
  )}
  {name === 'eye' && (
    <>
      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
      <circle cx="12" cy="12" r="3" />
    </>
  )}
  {name === 'code' && (
    <>
      <path d="m16 18 6-6-6-6M8 6l-6 6 6 6" />
    </>
  )}
  {name === 'sparkle' && (
    <>
      <path d="M12 3v6M12 15v6M3 12h6M15 12h6" />
