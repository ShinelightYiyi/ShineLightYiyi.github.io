  )}
  {name === 'github' && (
    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6.1A4.7 4.7 0 0 0 18.6 6c.3-.7.3-1.6 0-2.4 0 0-1-.3-3.4 1.3a11.7 11.7 0 0 0-6 0C6.7 3.3 5.7 3.6 5.7 3.6c-.3.8-.3 1.7 0 2.4A4.7 4.7 0 0 0 4.5 9.4c0 4.6 2.7 5.7 5.5 6.1-.6.6-.6 1.2-.5 2V21" />
  )}
  {name === 'zhihu' && (
